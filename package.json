{
  "name": "yoqart-fullstack",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "deploy:pages": "wrangler pages deploy public --project-name yoqart",
    "test": "node --test tests/*.test.js",
    "test:native": "python -m unittest discover -s tests -p test_native.py",
    "build": "wrangler pages functions build --outdir build/functions",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.18",
    "express": "^5.1.0",
    "html2pdf.js": "^0.14.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
